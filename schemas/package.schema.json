{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "id", "name", "author", "description", "version", "minAppVersion"],
  "properties": {
    "kind": {"enum": ["PLATFORM", "THEME"]},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "author": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "maxLength": 240},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "minAppVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "previewPath": {"type": "string", "pattern": "^previews/[a-zA-Z0-9._-]{1,120}\\.(png|webp)$"}
  }
}
