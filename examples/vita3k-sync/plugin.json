{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "org.retromao.vita3k-sync",
  "name": "Vita3K ROM 同步",
  "author": "4NPC",
  "version": "1.0.1",
  "minAppVersion": "0.9.98",
  "defaultLocale": "zh-Hans",
  "description": "同步 Vita3K 游戏本体、补丁、DLC 和许可。",
  "entryPoint": "main.js",
  "iconName": "gamepad",
  "capabilities": ["ROM_RESOURCES"],
  "settings": [{"id": "directory", "label": "Vita3K 目录", "kind": "DIRECTORY"}],
  "resourceProviders": [{
    "id": "installed",
    "platformId": "psv",
    "extensions": ["psvita"],
    "directorySetting": "directory",
    "rootPaths": ["", "fs", "vita", "files/fs", "files/vita"],
    "rootMarker": "ux0",
    "formatVersion": 1
  }],
  "license": "MIT",
  "localizations": {
    "zh-Hant": {
      "name": "Vita3K ROM 同步",
      "description": "同步 Vita3K 遊戲本體、更新、DLC 與授權。",
      "settings": {"directory": {"label": "Vita3K 目錄", "options": {}}}
    },
    "en": {
      "name": "Vita3K ROM sync",
      "description": "Sync Vita3K games, updates, DLC and licenses.",
      "settings": {"directory": {"label": "Vita3K directory", "options": {}}}
    },
    "ja": {
      "name": "Vita3K ROM 同期",
      "description": "Vita3K のゲーム本体・更新・DLC・ライセンスを同期。",
      "settings": {"directory": {"label": "Vita3K フォルダー", "options": {}}}
    }
  }
}
